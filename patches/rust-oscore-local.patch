+    #[test]
+    fn observe_notifications_share_request_piv_and_require_fresh_piv() {
+        let secret = [0x42; KEY_LEN];
+        // Client (decrypts notifications, sender_id [1]) and server (protects
+        // them, sender_id [0]) share the master secret.
+        let mut client = Context::new_ephemeral(&secret, None, &[1], &[0]).unwrap();
+        let mut server = Context::new_ephemeral(&secret, None, &[0], &[1]).unwrap();
+        let request_piv = &[0x14];
+
+        // First notification with a fresh explicit PIV decrypts and commits.
+        let (first_ciphertext, first_option) = server
+            .protect_response_with_piv(0x45, &[], b"first", &[1], request_piv)
+            .unwrap();
+        client
+            .begin_unprotect_observe_response(&first_option, &first_ciphertext, request_piv)
+            .unwrap()
+            .commit()
+            .unwrap();
+
+        // A second notification for the same registration request must not be
+        // rejected by the one-response-per-request guard.
+        let (second_ciphertext, second_option) = server
+            .protect_response_with_piv(0x45, &[], b"second", &[1], request_piv)
+            .unwrap();
+        client
+            .begin_unprotect_observe_response(&second_option, &second_ciphertext, request_piv)
+            .unwrap()
+            .commit()
+            .unwrap();
+
+        // A notification without an explicit PIV is rejected: its nonce would
+        // be derived from the shared request PIV and alias across notifications.
+        let (no_piv_ciphertext, no_piv_option) = server
+            .protect_response(0x45, &[], b"no-piv", &[1], request_piv, false)
+            .unwrap();
+        assert!(no_piv_option.is_empty());
+        assert!(matches!(
+            client.begin_unprotect_observe_response(
+                &no_piv_option,
+                &no_piv_ciphertext,
+                request_piv
+            ),
+            Err(OscoreError::InvalidParam)
+        ));
+
+        // The ordinary response path still consumes its request PIV exactly
+        // once: a second ordinary response for the same request is a replay.
+        let (ordinary_ciphertext, ordinary_option) = server
+            .protect_response_with_piv(0x45, &[], b"ordinary", &[1], request_piv)
+            .unwrap();
+        client
+            .begin_unprotect_response(&ordinary_option, &ordinary_ciphertext, request_piv)
+            .unwrap()
+            .commit()
+            .unwrap();
+        let (late_ciphertext, late_option) = server
+            .protect_response_with_piv(0x45, &[], b"late", &[1], request_piv)
+            .unwrap();
+        assert!(matches!(
+            client.begin_unprotect_response(&late_option, &late_ciphertext, request_piv),
+            Err(OscoreError::Replay)
+        ));
+        // The observe path is unaffected by that consumed slot.
+        let (third_ciphertext, third_option) = server
+            .protect_response_with_piv(0x45, &[], b"third", &[1], request_piv)
+            .unwrap();
+        assert!(client
+            .begin_unprotect_observe_response(&third_option, &third_ciphertext, request_piv)
+            .unwrap()
+            .commit()
+            .is_ok());
+    }
