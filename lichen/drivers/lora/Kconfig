config LORA_LICHEN_SIM
	bool "LICHEN simulator LoRa driver"
	depends on LORA
	select NET_SOCKETS
	select NET_SOCKETS_POSIX_NAMES
	help
	  TCP client driver for native_sim builds. Connects to the lichen-sim
	  server and presents a LoRa radio interface to the node stack.

if LORA_LICHEN_SIM

config LORA_LICHEN_SIM_HOST
	string "Simulator host address"
	default "127.0.0.1"

config LORA_LICHEN_SIM_PORT
	int "Simulator port"
	default 4444
	range 1 65535

config LORA_LICHEN_SIM_NODE_ID
	string "Node identifier sent to simulator at registration"
	default "node0"
	help
	  ASCII string identifying this node to the simulator (e.g. "gw0",
	  "node1"). Must be unique across all nodes in the simulation.

config LORA_LICHEN_SIM_SIM_ID
	string "Simulation run identifier"
	default "lichen"

config LORA_LICHEN_SIM_RX_THREAD_STACK_SIZE
	int "Simulator async RX thread stack size"
	default 4096
	help
	  Stack size for the lora_recv_async() RX thread. The thread runs
	  push-protocol RX_ENTER windows against the simulator server and
	  delivers frames to the registered callback, which runs the full
	  RX consumer (L2/IPv6/CoAP) on this stack.

config LORA_LICHEN_SIM_RX_THREAD_PRIORITY
	int "Simulator async RX thread priority"
	default 7
	range 0 NUM_PREEMPT_PRIORITIES
	help
	  Priority for the lora_recv_async() RX thread. Lower numbers have
	  higher priority in Zephyr. Valid preemptible values are
	  0..NUM_PREEMPT_PRIORITIES-1 (enforced at runtime when
	  CONFIG_ASSERT=y, the same idiom Zephyr's own Kconfigs use).

endif # LORA_LICHEN_SIM

config LORA_LICHEN_RENODE
	bool "LICHEN Renode LoRa driver"
	depends on LORA
	help
	  Memory-mapped driver for Renode LichenSubGHz peripheral. Bridges
	  to lichen-sim via the C# peripheral's TCP socket.

rsource "lr1110/Kconfig"
