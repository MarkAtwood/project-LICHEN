{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LICHEN relay signer identity chain vectors",
  "description": "Closed schema for relay_signer_chain.json: multi-hop relay signer identity, SRH destination mutation, fail-closed substitution, and SIID-indexed TOFU trust-cache behavior per spec/02-physical-link.md 4.2.",
  "type": "object",
  "required": [
    "$schema",
    "format_version",
    "name",
    "description",
    "spec",
    "provenance",
    "identities",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "format_version": {"const": 2},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "spec": {"type": "string"},
    "provenance": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "identities": {
      "type": "object",
      "required": ["A", "B", "C", "X"],
      "additionalProperties": false,
      "patternProperties": {
        "^[ABX]$": {"$ref": "#/definitions/identity"},
        "^C$": {"$ref": "#/definitions/identity"}
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/chain_vector"}
    }
  },
  "definitions": {
    "hex": {"type": "string", "pattern": "^[0-9a-f]*$"},
    "identity": {
      "type": "object",
      "required": ["role", "seed", "public_key", "siid_eui64"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string"},
        "seed": {"$ref": "#/definitions/hex"},
        "public_key": {"$ref": "#/definitions/hex"},
        "siid_eui64": {"$ref": "#/definitions/hex"}
      }
    },
    "frame_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "seqnum",
        "dst_addr",
        "payload",
        "mic",
        "addr_mode",
        "mic_length",
        "signature_present",
        "encrypted",
        "signer_eui64",
        "signer_eui64_present"
      ],
      "properties": {
        "epoch": {"type": "integer", "minimum": 0, "maximum": 255},
        "seqnum": {"type": "integer", "minimum": 0, "maximum": 65535},
        "dst_addr": {"$ref": "#/definitions/hex"},
        "payload": {"$ref": "#/definitions/hex"},
        "mic": {"$ref": "#/definitions/hex"},
        "addr_mode": {"type": "integer", "minimum": 0, "maximum": 3},
        "mic_length": {"type": "integer", "minimum": 0, "maximum": 1},
        "signature_present": {"type": "boolean"},
        "encrypted": {"type": "boolean"},
        "signer_eui64": {"$ref": "#/definitions/hex"},
        "signer_eui64_present": {"type": "boolean"}
      }
    },
    "frame_crypto": {
      "type": "object",
      "required": [
        "seed",
        "private_key",
        "public_key",
        "preimage",
        "wire_prefix",
        "signature",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": {"$ref": "#/definitions/hex"},
        "private_key": {"$ref": "#/definitions/hex"},
        "public_key": {"$ref": "#/definitions/hex"},
        "preimage": {"$ref": "#/definitions/hex"},
        "wire_prefix": {"$ref": "#/definitions/hex"},
        "signature": {"$ref": "#/definitions/hex"},
        "provenance": {"type": "string"}
      }
    },
    "trust_store": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/hex"}
    },
    "scenario": {
      "type": "object",
      "required": ["trust_store_before", "candidate_keys"],
      "additionalProperties": false,
      "properties": {
        "trust_store_before": {"$ref": "#/definitions/trust_store"},
        "candidate_keys": {
          "type": "array",
          "items": {"$ref": "#/definitions/hex"}
        }
      }
    },
    "expect": {
      "type": "object",
      "required": [
        "decision",
        "verify_pubkey",
        "must_not_verify_pubkeys",
        "authenticated_signer",
        "trust_store_after"
      ],
      "additionalProperties": false,
      "properties": {
        "decision": {"enum": ["accept", "reject"]},
        "reject_reason": {
          "enum": [
            "pinned_siid_verification_failed_no_fallback",
            "no_candidate_verified",
            "replay"
          ]
        },
        "verify_pubkey": {"oneOf": [{"$ref": "#/definitions/hex"}, {"type": "null"}]},
        "must_not_verify_pubkeys": {
          "type": "array",
          "items": {"$ref": "#/definitions/hex"}
        },
        "decoy_verifying_pubkeys": {
          "type": "array",
          "items": {"$ref": "#/definitions/hex"}
        },
        "authenticated_signer": {
          "oneOf": [{"$ref": "#/definitions/hex"}, {"type": "null"}]
        },
        "trust_store_after": {"$ref": "#/definitions/trust_store"}
      }
    },
    "sequence_expect": {
      "type": "object",
      "required": ["trust_store_after"],
      "additionalProperties": false,
      "properties": {
        "trust_store_after": {"$ref": "#/definitions/trust_store"}
      }
    },
    "sequence_operation": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["receive", "evict"]},
        "frame": {"type": "string"},
        "siid": {"$ref": "#/definitions/hex"},
        "expect": {
          "type": "object",
          "required": ["decision"],
          "additionalProperties": false,
          "properties": {
            "decision": {"enum": ["accept", "reject"]},
            "reject_reason": {
              "enum": [
                "pinned_siid_verification_failed_no_fallback",
                "no_candidate_verified",
                "replay"
              ]
            },
            "authenticated_signer": {"oneOf": [{"$ref": "#/definitions/hex"}, {"type": "null"}]},
            "trust_store_after": {"$ref": "#/definitions/trust_store"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"const": "receive"}}},
          "then": {"required": ["expect", "frame"]}
        }
      ]
    },
    "chain_vector": {
      "type": "object",
      "required": ["name", "kind", "description", "receiver", "scenario"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["frame", "sequence"]},
        "description": {"type": "string"},
        "receiver": {"enum": ["A", "B", "C", "X"]},
        "scenario": {"$ref": "#/definitions/scenario"},
        "fields": {"$ref": "#/definitions/frame_fields"},
        "encoded": {"$ref": "#/definitions/hex"},
        "crypto": {"$ref": "#/definitions/frame_crypto"},
        "expect": {"type": "object"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/sequence_operation"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "frame"}}},
          "then": {
            "required": ["fields", "encoded", "crypto", "expect"],
            "properties": {
              "expect": {"$ref": "#/definitions/expect"},
              "operations": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "sequence"}}},
          "then": {
            "required": ["operations", "expect"],
            "properties": {
              "expect": {"$ref": "#/definitions/sequence_expect"},
              "fields": {"maxProperties": 0},
              "encoded": {"maxLength": 0},
              "crypto": {"maxProperties": 0}
            }
          }
        }
      ]
    }
  }
}
