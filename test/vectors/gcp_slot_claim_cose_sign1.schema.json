{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GCP-6.5 slot-claim COSE_Sign1 admission corpus (spec/08 9.8)",
  "description": "Closed schema for gcp_slot_claim_cose_sign1.json: matches the committed generator output shape (generate_gcp_slot_claim_cose_sign1.py --check is the freshness oracle). Document fields: constants, identities, cases (bead project-LICHEN-worker6-m9pi).",
  "type": "object",
  "required": [
    "$schema",
    "vector_type",
    "format_version",
    "description",
    "oracle",
    "constants",
    "identities",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "vector_type": {
      "const": "gcp_slot_claim_cose_sign1"
    },
    "format_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "oracle": {
      "type": "object",
      "required": [
        "basis",
        "implementation",
        "generator_command",
        "freshness_command"
      ],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "generator_command": {
          "type": "string"
        },
        "freshness_command": {
          "type": "string"
        }
      }
    },
    "constants": {
      "type": "object",
      "required": [
        "algorithm",
        "protected_hex",
        "evaluation_time",
        "max_claim_duration_s",
        "clock_tolerance_s",
        "payload_keys",
        "reject_reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": -65537
        },
        "protected_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})+$"
        },
        "evaluation_time": {
          "type": "integer",
          "minimum": 0
        },
        "max_claim_duration_s": {
          "type": "integer",
          "minimum": 0
        },
        "clock_tolerance_s": {
          "type": "integer",
          "minimum": 0
        },
        "payload_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          }
        },
        "reject_reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "seed_hex",
          "public_key_hex",
          "iid_hex"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "seed_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "iid_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "expect_valid",
          "expected_reject_reason",
          "signer_name",
          "signer_seed_hex",
          "signer_public_key_hex",
          "signer_iid_hex",
          "kid_iid_hex",
          "algorithm",
          "protected_hex",
          "payload_hex",
          "signed_payload_hex",
          "sig_structure_hex",
          "digest_hex",
          "signature_hex",
          "cose_sign1_hex",
          "evaluation_time",
          "slots",
          "superframe_epoch",
          "mode",
          "expiry",
          "claim_seq",
          "ordinal",
          "max_claim_duration_s",
          "clock_tolerance_s"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string"
          },
          "expect_valid": {
            "type": "boolean"
          },
          "expected_reject_reason": {
            "enum": [
              "none",
              "signature",
              "replay",
              "expired",
              "algorithm",
              "kid_payload_mismatch",
              "ordinal_missing"
            ]
          },
          "signer_name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "signer_seed_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signer_public_key_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signer_iid_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "kid_iid_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "algorithm": {
            "type": "integer"
          },
          "protected_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "payload_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "signed_payload_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "sig_structure_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "digest_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "cose_sign1_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "evaluation_time": {
            "type": "integer",
            "minimum": 0
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "superframe_epoch": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0
          },
          "expiry": {
            "type": "integer",
            "minimum": 0
          },
          "claim_seq": {
            "type": "integer",
            "minimum": 0
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "max_claim_duration_s": {
            "type": "integer",
            "minimum": 0
          },
          "clock_tolerance_s": {
            "type": "integer",
            "minimum": 0
          },
          "receiver_cached_claim_seq": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
