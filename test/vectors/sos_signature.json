  "name": "sos_signature",
  "description": "SOS signature verification per spec Section 18.3/18.4.1. Covers link-layer signature (silent drop on invalid) and origin signature (domain separation, canonical CBOR, replay protection). All cryptographic values are real pinned bytes (Ed25519 seed 000102..1f); cross-verified Python->Rust before landing.",
  "spec": "spec/12-apps.md Section 18.3, 18.4.1",
  "signature_algorithm": "schnorr48",
  "origin_signature": {
    "domain": "LICHEN-SOS-ORIGIN-v1",
    "domain_hex": "4c494348454e2d534f532d4f524947494e2d7631",
    "domain_length": 20,
    "wire_format": "8-byte sequence (big-endian) + 48-byte Schnorr signature",
    "total_length": 56,
    "transcript": "SHA-512(domain || origin_ipv6 || seq || canonical_cbor_payload)",
