      "payload": {
        "type": "sos",
        "node": "206:2f7c:2006:18f7:a0f1:4791:738c:5a1f",
        "ts": 1716742800
      },
      "payload_cbor": "a36274731a66536a90646e6f646578263230363a326637633a323030363a313866373a613066313a343739313a373338633a35613166647479706563736f73",
      "origin_sequence": 1,
      "transcript_sha512": "741f4b70e67c6adbd74e9120f8ed23e65fa7d834792f50bf0adcbcff54dec4d23ad5e915f07974f423da672dacf7b1e2436493fd107dc07d2a2285af0dda77b0",
      "signature": "1ab3a39c313cad5edc9eae7ca274bf8370a30691abc49315f285241d0178d18af48500ed97357091152c2bbe1a047d08",
      "note": "Real pinned Schnorr48 keypair + upstream AddrForKey origin (decision upstream-yggdrasil-addressing). Signature verifies under LICHEN-SOS-ORIGIN-v1; the same payload signed under LICHEN-DAO-ORIGIN-v1 is in wrong_domain_rejected. Generated by the Python reference impl; cross-verified against Rust lichen-link sos_origin before landing."
    }
  },
