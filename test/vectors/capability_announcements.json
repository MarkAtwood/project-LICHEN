{
  "$schema": "./schema.json",
  "vector_type": "capability_announcements",
  "format_version": 1,
  "description": "COSE_Sign1 Capability Announcement vectors per spec/06-security.md Section 8.12. Uses Schnorr48-Ed25519 (alg -65537) with RFC 9052 Sig_structure and integer-keyed payloads.",
  "oracle": {
    "basis": "LICHEN spec/06-security.md Section 8.12",
    "sig_structure": "[\"Signature1\", protected, h\"\", payload] per RFC 9052",
    "signature_input": "SHA256(CBOR(Sig_structure))",
    "generator_command": "python3 test/vectors/generate_capability_announcements.py",
    "cross_check": "independent PyNaCl-backed reference_schnorr48.py",
    "announcer_iid": "low 8 bytes of upstream yggdrasil-go AddrForKey(pubkey); generator reimplementation anchored at runtime to the pinned upstream_addr_for_key vector in yggdrasil_address.json"
  },
  "constants": {
    "algorithm": {
      "id": -65537,
      "name": "Schnorr48-Ed25519",
      "signature_length": 48
    },
    "capability_bits": {
      "0": "egress",
      "1": "prefix_delegation",
      "2-7": "reserved (MUST be zero)"
    },
    "payload_keys": {
      "1": "capabilities",
      "2": "prefix",
      "3": "prefix_len",
      "4": "expiry",
      "5": "seq",
      "6": "announcer_iid"
    }
  },
