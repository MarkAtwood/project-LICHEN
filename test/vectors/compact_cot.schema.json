{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compact CoT binary encoding vectors (spec/07-transport-app.md 10.1.1)",
  "type": "object",
  "required": [
    "format_version",
    "description",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 2
    },
    "description": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "binary_hex",
          "decoded_fields"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string"
          },
          "binary_hex": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$"
          },
          "decoded_fields": {
            "type": "object"
          }
        }
      }
    }
  }
}
