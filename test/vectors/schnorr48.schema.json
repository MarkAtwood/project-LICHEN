{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schnorr-48 signature vectors (draft-lichen-schnorr-00, Appendix A)",
  "type": "object",
  "required": [
    "$schema",
    "format_version",
    "name",
    "description",
    "spec",
    "vectors"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format_version": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "spec": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "description",
          "public_key",
          "message",
          "signature",
          "valid"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "seed": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){32}$"
          },
          "private_key": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){32}$"
          },
          "public_key": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){32}$"
          },
          "message": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})*$",
            "description": "hex-encoded message bytes; may be empty"
          },
          "signature": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2})+$"
          },
          "valid": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
